# Set default behavior to automatically normalize line endings
* text=auto

# Enforce LF for bash scripts and ROS configurations
*.sh text eol=lf
*.bash text eol=lf
*.py text eol=lf
*.launch.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sdf text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf

# Enforce CRLF for Windows batch files
*.bat text eol=crlf
*.cmd text eol=crlf
