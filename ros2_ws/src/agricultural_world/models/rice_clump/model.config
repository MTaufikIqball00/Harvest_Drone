<?xml version="1.0"?>
<model>
  <name>Rice Clump</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Agricultural Field World Project</name>
  </author>
  <description>
    Rumpun tanaman padi kecil (cross-plane billboard, PBR alpha-cutout)
    untuk detail close-up di sepanjang pematang/jalur dekat drone,
    tanpa collision (murni visual) agar jumlahnya bisa banyak tanpa
    membebani physics engine.
  </description>
</model>
