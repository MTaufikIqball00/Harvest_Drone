<?xml version="1.0"?>
<model>
  <name>Realistic Tree - Mahogany</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Agricultural Field World Project</name>
  </author>
  <description>
    Pohon tropis berdaun lebar (gaya mahoni/trembesi, umum tumbuh di
    pinggir sawah Indonesia) dengan batang PBR bertekstur kulit kayu,
    cabang, dan tajuk daun multi-layer (vertical cross-plane + shoulder
    facet + top cap) sehingga terlihat baik dari sisi maupun dari atas
    (sudut pandang drone). Collision disederhanakan menjadi 1 cylinder
    (batang) + 1 ellipsoid (tajuk) agar tetap ringan untuk obstacle
    avoidance tanpa mengorbankan akurasi bounding volume.
  </description>
</model>
