<?xml version="1.0" ?>
<sdf version="1.9">
  <model name="realistic_tree_coconut">
    <static>true</static>
    <link name="body">

      <!-- ================= BATANG melengkung, 6 segmen cylinder beruntun ================= -->
      <visual name="trunk_seg_1">
