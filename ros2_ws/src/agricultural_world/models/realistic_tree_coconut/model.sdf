      <!-- ================= COLLISION disederhanakan =================
           1 cylinder besar membungkus seluruh lengkungan batang,
           1 ellipsoid untuk zona pelepah di pucuk. -->
      <collision name="trunk_collision">
        <pose>0.545 0.255 4.45 0 0 0</pose>
        <geometry><cylinder><radius>0.9</radius><length>8.9</length></cylinder></geometry>
      </collision>
      <collision name="crown_collision">
        <pose>1.091 0.509 8.3 0 0 0</pose>
        <geometry><ellipsoid><radii>3.3 3.3 1.6</radii></ellipsoid></geometry>
      </collision>

