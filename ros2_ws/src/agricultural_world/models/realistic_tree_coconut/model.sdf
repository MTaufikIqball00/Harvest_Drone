        <material><pbr><metal>
          <albedo_map>model://realistic_tree_coconut/materials/textures/bark_albedo.png</albedo_map>
          <normal_map>model://realistic_tree_coconut/materials/textures/bark_normal.png</normal_map>
          <roughness_map>model://realistic_tree_coconut/materials/textures/bark_roughness.png</roughness_map>
