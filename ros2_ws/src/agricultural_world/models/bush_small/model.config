<?xml version="1.0"?>
<model>
  <name>Small Bush</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Agricultural Field World Project</name>
  </author>
  <description>
    Semak kecil (cross-plane + top cap, PBR alpha-cutout) untuk detail
    lingkungan di sepanjang pematang dan tepi jalan. Memiliki collision
    cylinder kecil karena berpotensi menjadi obstacle rendah bagi drone
    yang terbang sangat dekat permukaan.
  </description>
</model>
