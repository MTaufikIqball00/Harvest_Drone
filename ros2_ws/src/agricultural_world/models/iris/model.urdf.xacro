<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="iris">
  <xacro:arg name="use_sim_time" default="true"/>
  <xacro:arg name="namespace" default="drone"/>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.5"/>
      <inertia
        ixx="0.029125"
        ixy="0.0"
        ixz="0.0"
        iyy="0.029125"
        iyz="0.0"
        izz="0.055225"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.48 0.14"/>
      </geometry>
      <material name="carbon">
        <color rgba="0.0 0.55 1.0 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.48 0.48 0.14"/>
      </geometry>
    </collision>
  </link>

  <link name="front_left_motor">
    <visual>
      <origin xyz="0.32 0.32 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="motor">
        <color rgba="1.0 0.96 0.25 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="front_left_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_left_motor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="front_right_motor">
    <visual>
      <origin xyz="0.32 -0.32 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="motor">
        <color rgba="1.0 0.96 0.25 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="front_right_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_right_motor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="rear_left_motor">
    <visual>
      <origin xyz="-0.32 0.32 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="motor">
        <color rgba="1.0 0.96 0.25 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="rear_left_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_left_motor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="rear_right_motor">
    <visual>
      <origin xyz="-0.32 -0.32 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.08" length="0.04"/>
      </geometry>
      <material name="motor">
        <color rgba="1.0 0.96 0.25 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="rear_right_motor_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_right_motor"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="visibility_beacon">
    <visual>
      <origin xyz="0 0 0.28" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.16"/>
      </geometry>
      <material name="beacon_orange">
        <color rgba="1.0 0.28 0.0 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="visibility_beacon_joint" type="fixed">
    <parent link="base_link"/>
    <child link="visibility_beacon"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
</robot>
