<?xml version="1.0"?>
<model>
  <name>Realistic Tree - Mahogany (Large / Hero Obstacle)</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Agricultural Field World Project</name>
  </author>
  <description>
    Varian besar (skala ~1.4x) dari realistic_tree_mahogany, dipakai
    sebagai obstacle tunggal yang menonjol di tengah lahan sawah untuk
    pengujian obstacle avoidance drone. Menggunakan tekstur yang sama
    dengan realistic_tree_mahogany (dirujuk via model:// lintas-folder)
    supaya tidak menduplikasi file gambar.
  </description>
</model>
