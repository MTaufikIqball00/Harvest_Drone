# =============================================================================
# Konfigurasi PostgreSQL / Supabase untuk node ROS 2 telemetry logger
# =============================================================================
# Salin jadi .env.supabase, isi nilainya, lalu: source .env.supabase
#
# Ambil nilainya di Supabase: Project Settings -> Database -> Connection info.
# PENTING: pakai koneksi "Session pooler" (port 5432) atau "Direct connection".
# JANGAN pakai "Transaction pooler" (port 6543) — mode itu tidak mendukung
# prepared statement yang dipakai psycopg2.executemany(), dan flush batch
# akan gagal terus-menerus.

export DRONE_DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
export DRONE_DB_PORT=5432
export DRONE_DB_USER=postgres
export DRONE_DB_PASSWORD=ganti-dengan-password-database-supabase
export DRONE_DB_NAME=postgres

# require = wajib TLS (Supabase). Untuk PostgreSQL lokal pakai: prefer
export DRONE_DB_SSLMODE=require

export DRONE_DB_DRONE_ID=1
export DRONE_DB_MISSION_ID=0
export DRONE_DB_TELEMETRY_HZ=5.0
export DRONE_DB_STATE_HZ=1.0
export DRONE_DB_BATCH_SIZE=100
export DRONE_DB_FLUSH_SEC=1.0
export DRONE_DB_MAX_QUEUE=5000
