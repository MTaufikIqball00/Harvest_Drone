# =============================================================================
# DRONE-STACK MONOREPO CENTRALIZED CONFIGURATION
# =============================================================================

# --- Environment & WSL Distro ---
WSL_DISTRO=UAV
PX4_DIR=/home/iqball/drone-stack/external/PX4-Autopilot
ROS_SETUP=/opt/ros/jazzy/setup.bash

# --- Next.js Frontend ---
PORT=3000
NEXT_PUBLIC_FASTAPI_URL=http://127.0.0.1:8000
NEXT_PUBLIC_ROSBRIDGE_URL=ws://127.0.0.1:9090

# Titik tengah awal peta + origin proyeksi untuk mode tanpa GPS.
# HARUS berada di dalam area basemap offline (frontend/public/map/basemap.pmtiles),
# kalau tidak peta terbuka di layar kosong saat di lapangan tanpa internet.
# Default kode: Gg. Sawah Lega III, Cimahi Utara.
# Mengganti area? Jalankan dulu: bash scripts/extract_offline_map.sh
NEXT_PUBLIC_ORIGIN_LAT=-6.8655
NEXT_PUBLIC_ORIGIN_LON=107.5412

# --- Backend AI FastAPI Service ---
FASTAPI_HOST=0.0.0.0
# Port 3001 agar tidak bentrok dengan frontend Next.js (port 3000)
ODM_NODE_URL=http://localhost:3001

# --- Database PostgreSQL / Supabase ---
# Ambil di Supabase: Project Settings -> Database -> Connection info.
# Pakai "Session pooler"/"Direct connection" (port 5432), BUKAN "Transaction
# pooler" (6543) yang tidak mendukung prepared statement.
DB_HOST=db.xxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=ganti-dengan-password-database-supabase
DB_NAME=postgres
# true = wajib TLS (Supabase). Untuk PostgreSQL lokal, kosongkan atau false.
DB_SSL=true

# --- Login Operator (dashboard Next.js) ---
# Kunci penanda tangan cookie sesi. WAJIB diisi, minimal 32 karakter acak —
# tanpa ini login akan menolak dengan pesan yang jelas, bukan diam-diam jalan
# tanpa pengaman. Buat nilainya dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Mengganti nilai ini otomatis mengeluarkan semua sesi yang sedang berjalan.
AUTH_SECRET=ganti-dengan-32-byte-hex-acak

# --- Dual Bridge & Robotics ---
ROSBRIDGE_PORT=9090
XRCE_DDS_PORT=8888
MAVROS_PORT=14540
PX4_MAVLINK_PORT=14550
